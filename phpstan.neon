# PHPStan configuration for diluxone-mail.
#
# Level 8 (max strictness) on the production code. The WordPress
# extension (szepeviktor/phpstan-wordpress) is auto-registered via the
# phpstan/extension-installer composer plugin — no manual `includes:`
# needed for it.

parameters:
  level: 8

  bootstrapFiles:
    - phpstan-bootstrap.php

  # WP-CLI is not loaded when the site runs, so the plugin's command lives
  # behind a `defined( 'WP_CLI' )`. The stubs give the analysis the class that
  # WP-CLI provides at runtime.
  scanFiles:
    - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php

  paths:
    - diluxone-mail.php
    - includes
    - templates

  excludePaths:
    analyse:
      - tests/*
      - vendor/*
      - node_modules/*
      - .wordpress-org/*
      - assets/*

  # The plugin declares PHP 8.1 as its minimum, same as its header.
  phpVersion: 80100

  # They are stubbed in phpstan-bootstrap.php so the analysis can see them, but
  # their real value comes from wp-config.php and changes per install. Marking
  # them dynamic keeps PHPStan from resolving an `if ( WP_DEBUG )` as always
  # false because of the stub's value.
  dynamicConstantNames:
    - WP_DEBUG
    - COOKIEHASH
