# PHPStan configuration for diluxone-mail.
#
# Level 8 (max strictness) on the production code. The WordPress
# extension (szepeviktor/phpstan-wordpress) is auto-registered via the
# phpstan/extension-installer composer plugin — no manual `includes:`
# needed for it.

parameters:
  level: 8

  bootstrapFiles:
    - phpstan-bootstrap.php

  # WP-CLI no está cargado cuando corre el sitio, así que el comando del
  # plugin vive detrás de un `defined( 'WP_CLI' )`. Los stubs le dan al
  # análisis la clase que en tiempo real trae WP-CLI.
  scanFiles:
    - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php

  paths:
    - diluxone-mail.php
    - includes
    - templates

  excludePaths:
    analyse:
      - tests/*
      - vendor/*
      - node_modules/*
      - .wordpress-org/*
      - assets/*

  # El plugin declara PHP 8.1 como mínimo, igual que su cabecera.
  phpVersion: 80100

  # Se stubean en phpstan-bootstrap.php para que el análisis las vea, pero su
  # valor real sale de wp-config.php y cambia por instalación. Marcarlas
  # dinámicas evita que PHPStan resuelva un `if ( WP_DEBUG )` como si siempre
  # fuera falso por el valor del stub.
  dynamicConstantNames:
    - WP_DEBUG
    - COOKIEHASH
