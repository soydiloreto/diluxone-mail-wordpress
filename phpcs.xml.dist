<?xml version="1.0"?>
<ruleset name="DiluxOne Mail">
    <description>
        WordPress Coding Standards configuration for the DiluxOne Mail plugin.
        Strict mode — runs the full WordPress ruleset (Core + Docs + Extra) plus
        PHP 8.1+ compatibility checks. No baseline.
    </description>

    <!-- Files / paths to scan -->
    <file>diluxone-mail.php</file>
    <file>includes/</file>
    <file>templates/</file>

    <!-- Files / paths to exclude (mirrors .distignore where applicable) -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/.wordpress-org/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>
    <exclude-pattern>*.min.css</exclude-pattern>

    <!-- CLI behaviour. Cache is intentionally not configured here — PHPCS
         requires the parent directory to exist before it can write the
         cache file, which adds friction on fresh clones and cold CI
         runs. Local devs can opt in by passing the cache flag on the
         command line after creating the directory manually. -->
    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg name="extensions" value="php"/>

    <!-- WordPress Coding Standards: Core, Extra, Docs -->
    <rule ref="WordPress"/>

    <!-- Plugin metadata for naming-convention checks -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="diluxone_mail"/>
                <element value="DILUXONE_MAIL"/>
            </property>
        </properties>
    </rule>

    <!-- Parameter documentation: native typing provides it, not the docblock.

         WPCS wants an @param per parameter. The rule dates from when PHP had
         no types: the docblock was the only place to say something was an
         `int`. This plugin declares PHP 8.1 as its minimum and types its
         signatures for real — `function diluxone_mail_config_value( string
         $field ): array` — so an @param would repeat what the interpreter
         already checks, with the downside that a docblock can go stale and a
         native type cannot.

         What is genuinely required is still required: the docblocks are there,
         they explain WHY each function exists, and the ones returning a shape
         a native type cannot describe — an array with keys — carry their
         @return. No type replaces that. -->
    <rule ref="Squiz.Commenting.FunctionComment.MissingParamTag">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.ParamNameNoMatch">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.IncorrectTypeHint">
        <severity>0</severity>
    </rule>

    <!-- One item per line in a single-dimension array.

         The rule exists so a configuration array reads top to bottom, and for
         that it is right. But it also catches word lists — the DKIM selectors
         the big providers use, a provider's SPF includes — where splitting
         eleven words across eleven lines makes nothing more readable: it makes
         a column nobody reads.

         Keyed arrays still demand a line per item, which is the case where the
         rule genuinely helps. -->
    <rule ref="WordPress.Arrays.ArrayDeclarationSpacing.ArrayItemNoNewLine">
        <severity>0</severity>
    </rule>

    <!-- Text domain check -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="diluxone-mail"/>
            </property>
        </properties>
    </rule>

    <!-- =================================================================
         RULE EXCLUSIONS — deliberate project choices, NOT a baseline.
         Each exclusion below is paired with a justification. The goal
         is to keep WPCS strict on substantive rules (security, deprecated
         APIs, naming where it matters) while turning off cosmetic
         preferences that produce noise without making the code better.
         ================================================================= -->

    <!-- Yoda conditions are explicitly NOT used in this project (see
         .github/copilot-instructions.md). Modern style is `$x === 5`,
         not `5 === $x`. -->
    <rule ref="WordPress.PHP.YodaConditions.NotYoda">
        <severity>0</severity>
    </rule>

    <!-- Cosmetic comment formatting rules — these flag missing periods
         at end of inline comments, missing short descriptions in
         docblocks, missing comment text on @param tags whose type is
         already self-explanatory, etc. They produce noise (650+ in this
         codebase) without making the code clearer. Substantive rules
         like FunctionComment.MissingParamTag and ClassComment.Missing
         remain active. -->
    <rule ref="Squiz.Commenting.InlineComment.InvalidEndChar">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.ParamCommentFullStop">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.MissingParamComment">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.ThrowsNoFullStop">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.Commenting.DocComment.MissingShort">
        <severity>0</severity>
    </rule>

    <!-- base64_decode is how a DKIM public key is read: the standard
         publishes it base64-encoded in the p= tag, and measuring the key size
         means decoding it. base64_encode is how the SMTP dialogue carries an
         AUTH LOGIN credential, which is why redaction has to cover it. The
         "discouraged for obfuscation" rule is about hiding malicious payloads,
         not about reading a format somebody else defined. -->
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode">
        <severity>0</severity>
    </rule>

    <!-- Unused-parameter detection produces frequent false positives on
         WordPress callback signatures (filters, actions, REST routes)
         where the parameter list is dictated by the hook contract, not
         the implementation. -->
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
        <severity>0</severity>
    </rule>

    <!-- PHPMailer's own properties are PascalCase — $phpmailer->SMTPAuth,
         ->Host, ->CharSet — and that is the API this plugin has to write to.
         The rule is about the names we choose, not the ones a library
         imposes. -->
    <rule ref="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase">
        <severity>0</severity>
    </rule>

    <!-- File naming: the log's WP_List_Table subclass lives in
         includes/log-list-table.php, named after what the file does rather
         than after the class it happens to declare, like every other file in
         includes/. It is the plugin's only class. -->
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <severity>0</severity>
    </rule>

    <!-- Plugin minimum WordPress version. 6.2 is where $wpdb->prepare()
         gained the %i identifier placeholder, which is how the log's table
         names reach the query. -->
    <config name="minimum_supported_wp_version" value="6.2"/>

    <!-- PHP compatibility: must run cleanly on PHP 8.1 and up -->
    <config name="testVersion" value="8.1-"/>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
