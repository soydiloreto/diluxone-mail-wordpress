#. translators: %s: provider name
#: templates/settings-api.php:40
#, php-format
msgid ""
"Messages go out over HTTPS to %s. There is no server, no port and no SMTP "
"password: one key does all of it, and the provider answers in words when it "
"refuses a message."
msgstr ""
"Los mensajes salen por HTTPS hacia %s. No hay servidor, ni puerto, ni "
"contraseña de SMTP: una sola clave hace todo, y el proveedor contesta en "
"palabras cuando rechaza un mensaje."

#: templates/settings-api.php:48
msgid "Key"
msgstr "Clave"

#: templates/settings-api.php:54 templates/settings-server.php:132
