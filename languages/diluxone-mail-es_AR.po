#. Plugin Name of the plugin
#: diluxone-mail.php
msgid "DiluxOne Mail – SMTP, Email Log & Deliverability Diagnostics"
msgstr ""
"DiluxOne Mail – SMTP, registro de correo y diagnóstico de entregabilidad"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: diluxone-mail.php
msgid "https://pablodiloreto.com"
msgstr "https://pablodiloreto.com"

#. Description of the plugin
#: diluxone-mail.php
msgid ""
"Connect WordPress to any SMTP provider, keep a log of every message — "
"including one per person, on their user profile — and find out whether the "
"domain's SPF, DKIM and DMARC records actually let that mail arrive."
msgstr ""
"Conectá WordPress a cualquier proveedor SMTP, guardá un historial de cada "
"mensaje —incluido uno por persona, en su ficha de usuario— y averiguá si los"
" registros SPF, DKIM y DMARC del dominio dejan llegar ese correo."

#. Author of the plugin
#: diluxone-mail.php
msgid "Pablo Ariel Di Loreto"
msgstr "Pablo Ariel Di Loreto"

